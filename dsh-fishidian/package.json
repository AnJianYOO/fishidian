{
  "name": "dsh-fishidian",
  "version": "0.1.3",
  "description": "小鱼情感记忆经络系统 DSH 插件：TypeScript 薄壳 + 本地 Python 内核（fishidian-core）。对话前注入记忆（三池/熔断/节流/体质 P/出站脱敏/注入三闸），回合后回写（连发合并成一轮），/记忆 /状态 /忘 命令，10 分钟巡检。",
  "type": "module",
  "main": "lib/index.js",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "memory", "emotion", "companion", "cordis"],
  "license": "CC-BY-NC-4.0",
  "engines": { "node": ">=20.0.0" },
  "files": ["lib", "assets", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.7-rc.2": "unknown",
        "0.2.0-rc.1": "unknown",
        "0.2.1-rc.2": "unknown"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
